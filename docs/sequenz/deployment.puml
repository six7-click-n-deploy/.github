@startuml Deployment Process

!define C4Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Deployment Process - Sequence Diagram

actor "User" as User
participant "Frontend\n[Container: Vue.js]" as Frontend
participant "Backend API\n[Container: FastAPI]" as Backend
database "PostgreSQL\n[Container: Database]" as Database
queue "RabbitMQ\n[Container: Message Broker]" as RabbitMQ
participant "Celery Worker\n[Container: Python]" as Worker
participant "OpenStack\n[External System]" as OpenStack
participant "Git Repository\n[External System]" as Git

== Deployment Creation ==

User -> Frontend: Fill form and\nclick "Create Deployment"
activate Frontend

Frontend -> Backend: POST /api/deployments\n{name, appId, releaseTag,\nuserInputVar, teams[]}
activate Backend

Backend -> Backend: get_current_user_keycloak()

Backend -> Database: create_deployment(\nname, appId, userId,\nreleaseTag, userInputVar)
activate Database

Database --> Backend: deployment object
deactivate Database

alt teams provided

Backend -> Database: create_teams_for_deployment(\ndeploymentId, teams[])
activate Database
loop for each team
    Database -> Database: create Team(\nname, deploymentId)
    loop for each userId in team
        Database -> Database: create UserToTeam(\nuserId, teamId)
    end
end
Database --> Backend: team objects
deactivate Database

Backend -> Database: create_user_to_deployments(\ndeploymentId, user_ids)
activate Database

loop for each userId
    Database -> Database: create UserToDeployment(\nuserId, deploymentId)
end
Database --> Backend: user associations
deactivate Database

end

Backend -> Backend: parse userInputVar JSON

Backend -> Backend: format_teams_dict()

Backend -> Backend: task_service.register_new_task()

Backend -> Database: get_tasks(deploymentId)
activate Database
Database --> Backend: existing tasks
deactivate Database

alt no active tasks (PENDING/RUNNING)

Backend -> RabbitMQ: celery_app.send_task(\n"tasks.deploy_application",\nargs=[...])
activate RabbitMQ
RabbitMQ --> Backend: AsyncResult with celery_task_id
deactivate RabbitMQ

Backend -> Database: create_task(\ndeploymentId, celeryTaskId,\ntype: DEPLOY,\nstatus: PENDING)
activate Database

Database --> Backend: task object
deactivate Database

Backend --> Frontend: 201 Created\nDeploymentResponse
deactivate Backend

Frontend --> User: Deployment created
deactivate Frontend

else active task exists

Backend --> Frontend: 400 Bad Request\n"Active task already running"
deactivate Backend

Frontend --> User: Error: Cannot create deployment,\nactive task in progress
deactivate Frontend

end

== Background Task Execution ==

RabbitMQ -> Worker: task message received\nfrom queue
activate Worker

Worker -> RabbitMQ: emit task-started event\n{type: 'task-started',\nuuid: celery_task_id}
activate RabbitMQ

RabbitMQ --> Backend: event received
deactivate RabbitMQ
activate Backend

Backend -> Database: get_task(\ncelery_task_id)
activate Database
Database --> Backend: task object
deactivate Database

Backend -> Database: update_task(\ntaskId,\n{status: RUNNING,\nstarted_at: utcnow()})
activate Database

Database --> Backend: updated task
deactivate Database

deactivate Backend

Worker -> Worker: get_openstack_credentials()\nfrom clouds.yaml

Worker -> Git: git_service.clone_release(\ndeployment_id, git_url, tag)
activate Git
Git --> Worker: repo_path (local directory)
deactivate Git

alt packer/template.pkr.hcl exists

    Worker -> Worker: image_name = appId + "-" + release

    Worker -> OpenStack: check_image_exists(image_name)
    activate OpenStack
    OpenStack --> Worker: (exists: bool, image_id: str)
    deactivate OpenStack

    alt image does not exist
        Worker -> Worker: PackerExecutor.init()

        Worker -> Worker: merge packer_vars:\nuser_vars["packer"] +\nimage_name

        Worker -> Worker: PackerExecutor.validate(\ntemplate.pkr.hcl, packer_vars) 
        
        Worker -> Worker: PackerExecutor.build(\ntemplate.pkr.hcl,\npacker_vars)
    end
end

Worker -> Worker: TerraformExecutor.init()

Worker -> Worker: merge terraform_vars:\nuser_vars["terraform"] +\nimage_name + users (teams)

Worker -> Worker: TerraformExecutor.plan(\nvariables: terraform_vars)

Worker -> OpenStack: TerraformExecutor.apply(\nvariables: terraform_vars)
activate OpenStack
OpenStack --> Worker: resources created
deactivate OpenStack

Worker -> Worker: collect_terraform_outputs()

Worker -> Worker: collect_terraform_state()

Worker -> Worker: git_service.cleanup_repository(\nrepo_path)

Worker -> RabbitMQ: emit task-succeeded event\n{type: 'task-succeeded',\nuuid: celery_task_id,\nresult: {...}}
activate RabbitMQ
note right
  result = {
    status: "success",
    deployment_id: str,
    logs: list[dict],
    tf_state: str,
    terraform_outputs: dict
  }
end note

RabbitMQ --> Backend: event received
deactivate RabbitMQ
activate Backend

Backend -> Database: get_tasks(\ncelery_task_id)
activate Database
Database --> Backend: task object
deactivate Database

Backend -> Database: update_task(\ntaskId,\n{status: SUCCESS,\nfinished_at: utcnow(),\nlogs: json.dumps(result['logs']),\ntf_state: result['tf_state'],\noutputs: json.dumps(result['terraform_outputs'])})
activate Database
Database --> Backend: updated task
deactivate Database

deactivate Backend

deactivate Worker

== Error Handling ==

alt Task fails at any step

    Worker -> Worker: catch Exception
    note right
        Will be thrown if one of the steps in the Background Task Execution fails
    end note

    Worker -> Worker: collect_terraform_state()\nif terraform_dir exists


    Worker -> Worker: collect_terraform_outputs()\nif terraform_dir exists

    Worker -> Worker: git_service.cleanup_repository()

    Worker -> RabbitMQ: emit task-failed event\n{type: 'task-failed',\nuuid: celery_task_id,\nexception: Failure(...)}
    activate RabbitMQ
    note right
      Failure exception contains
      JSON-encoded data:
      {
        error: str,
        deployment_id: str,
        logs: list[dict],
        tf_state: str | None,
        terraform_outputs: dict | None
      }
    end note

    RabbitMQ --> Backend: event received
    deactivate RabbitMQ
    activate Backend

    Backend -> Database: get_tasks(\ncelery_task_id)
    activate Database
    Database --> Backend: task object
    deactivate Database

    Backend -> Backend: parse exception JSON\nvia regex extraction
    note right
      Extracts structured data
      from Failure exception message
    end note

    Backend -> Database: update_task(\ntaskId,\n{status: FAILED,\nfinished_at: utcnow(),\nlogs: formatted logs + error,\ntf_state: partial state,\noutputs: partial outputs})
    activate Database
    Database --> Backend: updated task
    deactivate Database

    deactivate Backend

end

== User retrieves deployment status ==

User -> Frontend: View deployment details
activate Frontend

Frontend -> Backend: GET /deployments/{id}
activate Backend

Backend -> Backend: get_current_user_keycloak()

Backend -> Backend: ensure_resource_access(\ndeployment.userId, current_user)

Backend -> Database: get_deployment(\ndeploymentId)\nwith eager loading
activate Database
note right
  deployment.user
  deployment.app
  deployment.tasks
  deployment.teams
end note
Database --> Backend: Deployment with relations
deactivate Database

note right
  status is derived
  from deployment.tasks:
  - Latest task status
  - PENDING/RUNNING/SUCCESS/FAILED
end note

Backend --> Frontend: DeploymentWithRelations

deactivate Backend

Frontend --> User: Display deployment:\n- status (from tasks)\n- logs (from latest task)\n- outputs (from latest task)
deactivate Frontend

@enduml